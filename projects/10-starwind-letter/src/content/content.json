{
  "messages": [
    { "id": "calm-01", "text": "今晚允许自己慢一点。", "mood": "calm", "weight": 1 },
    { "id": "calm-02", "text": "今天已经足够了。", "mood": "calm", "weight": 1 },
    { "id": "calm-03", "text": "没完成的事，明天还可以继续。", "mood": "calm", "weight": 1 },
    { "id": "calm-04", "text": "你不必在今晚想明白一切。", "mood": "calm", "weight": 1 },
    { "id": "calm-05", "text": "有些疲惫，只需要被看见。", "mood": "calm", "weight": 1 },
    { "id": "calm-06", "text": "先照顾好此刻的自己。", "mood": "calm", "weight": 1 },
    { "id": "calm-07", "text": "不必对每件事都有答案。", "mood": "calm", "weight": 1 },
    { "id": "calm-08", "text": "休息也在为明天积攒力量。", "mood": "calm", "weight": 1 },
    { "id": "calm-09", "text": "今晚，世界可以暂时安静。", "mood": "calm", "weight": 1 },
    { "id": "calm-10", "text": "慢一点，并不代表落后。", "mood": "calm", "weight": 1 },
    { "id": "calm-11", "text": "你可以先放下那些着急。", "mood": "calm", "weight": 1 },
    { "id": "calm-12", "text": "好好睡一觉，再去回答世界。", "mood": "calm", "weight": 1 },
    { "id": "hope-01", "text": "好消息正在穿过漫长的夜晚。", "mood": "hope", "weight": 1 },
    { "id": "hope-02", "text": "你正在靠近想去的地方。", "mood": "hope", "weight": 1 },
    { "id": "hope-03", "text": "某个温柔的改变已经开始。", "mood": "hope", "weight": 1 },
    { "id": "hope-04", "text": "也许明天，会有小小惊喜", "mood": "hope", "weight": 1 },
    { "id": "hope-05", "text": "你的勇敢正在悄悄发芽。", "mood": "hope", "weight": 1 },
    { "id": "hope-06", "text": "有些答案会在放松时出现。", "mood": "hope", "weight": 1 },
    { "id": "hope-07", "text": "下一阵风会带来新的方向。", "mood": "hope", "weight": 1 },
    { "id": "hope-08", "text": "还没有发生，不代表不会发生。", "mood": "hope", "weight": 1 },
    { "id": "hope-09", "text": "属于你的季节正在路上。", "mood": "hope", "weight": 1 },
    { "id": "hope-10", "text": "前面还有你没见过的风景。", "mood": "hope", "weight": 1 },
    { "id": "hope-11", "text": "黎明已经在夜色深处出发。", "mood": "hope", "weight": 1 },
    { "id": "hope-12", "text": "愿一件好事慢慢靠近", "mood": "hope", "weight": 1 },
    { "id": "missing-01", "text": "想念会在星光里找到方向。", "mood": "missing", "weight": 1 },
    { "id": "missing-02", "text": "真正的靠近，不需要用力证明。", "mood": "missing", "weight": 1 },
    { "id": "missing-03", "text": "有些相遇正在悄悄发生。", "mood": "missing", "weight": 1 },
    { "id": "missing-04", "text": "温柔终会遇见温柔的回应。", "mood": "missing", "weight": 1 },
    { "id": "missing-05", "text": "一句没说出口的话仍被听见。", "mood": "missing", "weight": 1 },
    { "id": "missing-06", "text": "距离不会抹去重要的事情。", "mood": "missing", "weight": 1 },
    { "id": "missing-07", "text": "有人在看不见的地方祝福你。", "mood": "missing", "weight": 1 },
    { "id": "missing-08", "text": "被记得，本身就是一种拥抱。", "mood": "missing", "weight": 1 },
    { "id": "missing-09", "text": "一颗星正在替你说出想念。", "mood": "missing", "weight": 1 },
    { "id": "missing-10", "text": "该留下的人，会认出你的光。", "mood": "missing", "weight": 1 },
    { "id": "missing-11", "text": "月亮替你收藏了那份惦念。", "mood": "missing", "weight": 1 },
    { "id": "missing-12", "text": "有些牵挂不必急着抵达。", "mood": "missing", "weight": 1 },
    { "id": "courage-01", "text": "你的感受值得被认真对待。", "mood": "courage", "weight": 1 },
    { "id": "courage-02", "text": "不必缩小自己来适应世界。", "mood": "courage", "weight": 1 },
    { "id": "courage-03", "text": "你可以重新选择方向。", "mood": "courage", "weight": 1 },
    { "id": "courage-04", "text": "柔软从来不是软弱。", "mood": "courage", "weight": 1 },
    { "id": "courage-05", "text": "你比昨天更接近自己。", "mood": "courage", "weight": 1 },
    { "id": "courage-06", "text": "拒绝不适合的事也是前进。", "mood": "courage", "weight": 1 },
    { "id": "courage-07", "text": "你拥有重新开始的能力。", "mood": "courage", "weight": 1 },
    { "id": "courage-08", "text": "不被理解，不代表你是错的。", "mood": "courage", "weight": 1 },
    { "id": "courage-09", "text": "你正在成为自己的依靠。", "mood": "courage", "weight": 1 },
    { "id": "courage-10", "text": "今天的你也可以选择转弯。", "mood": "courage", "weight": 1 },
    { "id": "courage-11", "text": "不慌张，也是一种坚定。", "mood": "courage", "weight": 1 },
    { "id": "courage-12", "text": "你有权走一条自己的路。", "mood": "courage", "weight": 1 },
    { "id": "dream-01", "text": "月亮为迟归的人留了一盏灯。", "mood": "dream", "weight": 1 },
    { "id": "dream-02", "text": "今夜的风知道你的名字。", "mood": "dream", "weight": 1 },
    { "id": "dream-03", "text": "一颗星正穿过夜空向你而来。", "mood": "dream", "weight": 1 },
    { "id": "dream-04", "text": "梦会记住没说出口的话。", "mood": "dream", "weight": 1 },
    { "id": "dream-05", "text": "有些花只在安静时开放。", "mood": "dream", "weight": 1 },
    { "id": "dream-06", "text": "风把远方折成了一封信。", "mood": "dream", "weight": 1 },
    { "id": "dream-07", "text": "星星落进房间，是夜的回信。", "mood": "dream", "weight": 1 },
    { "id": "dream-08", "text": "月光会替你保守秘密。", "mood": "dream", "weight": 1 },
    { "id": "dream-09", "text": "夜晚正把世界调成温柔的颜色。", "mood": "dream", "weight": 1 },
    { "id": "dream-10", "text": "宇宙刚为你留出一点空白。", "mood": "dream", "weight": 1 },
    { "id": "dream-11", "text": "窗外的星光正在寻找你。", "mood": "dream", "weight": 1 },
    { "id": "dream-12", "text": "今晚，有一颗星为你而来。", "mood": "dream", "weight": 1 }
  ],
  "fallback": { "id": "system-fallback", "text": "今晚，先听一听风", "mood": "calm", "weight": 1 }
}
