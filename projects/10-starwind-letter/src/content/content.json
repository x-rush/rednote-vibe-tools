{
  "messages": [
    { "id": "calm-01", "text": "你已经很努力了，今晚安心休息吧。", "mood": "calm", "weight": 1 },
    { "id": "calm-02", "text": "今天辛苦了，没完成的事明天再继续。", "mood": "calm", "weight": 1 },
    { "id": "calm-03", "text": "允许自己停一停，休息也是前进。", "mood": "calm", "weight": 1 },
    { "id": "calm-04", "text": "此刻不必解决一切，先照顾好自己。", "mood": "calm", "weight": 1 },
    { "id": "calm-05", "text": "疲惫不是脆弱，是身体提醒你休息。", "mood": "calm", "weight": 1 },
    { "id": "calm-06", "text": "累了就停在这里，明天再接着走。", "mood": "calm", "weight": 1 },
    { "id": "calm-07", "text": "那些没人看见的努力，也一直算数。", "mood": "calm", "weight": 1 },
    { "id": "calm-08", "text": "你已经尽力了，剩下的交给明天。", "mood": "calm", "weight": 1 },
    { "id": "calm-09", "text": "允许自己失望，但别因此否定自己。", "mood": "calm", "weight": 1 },
    { "id": "calm-10", "text": "先照顾好情绪，再处理那些难题。", "mood": "calm", "weight": 1 },
    { "id": "calm-11", "text": "今天能撑到现在，已经很不容易。", "mood": "calm", "weight": 1 },
    { "id": "calm-12", "text": "今晚不必证明自己，安心睡一会儿。", "mood": "calm", "weight": 1 },
    { "id": "hope-01", "text": "你没有白走，那些路正在成为底气。", "mood": "hope", "weight": 1 },
    { "id": "hope-02", "text": "现在看不见答案，不代表没有答案。", "mood": "hope", "weight": 1 },
    { "id": "hope-03", "text": "慢一点没问题，你仍在向前。", "mood": "hope", "weight": 1 },
    { "id": "hope-04", "text": "你走过的弯路，也会变成方向。", "mood": "hope", "weight": 1 },
    { "id": "hope-05", "text": "别拿别人的进度，催促自己的春天。", "mood": "hope", "weight": 1 },
    { "id": "hope-06", "text": "事情会有转机，你也会有新的力气。", "mood": "hope", "weight": 1 },
    { "id": "hope-07", "text": "一次没做好，不等于你做不好。", "mood": "hope", "weight": 1 },
    { "id": "hope-08", "text": "你可以重新开始，不必等到万事俱备。", "mood": "hope", "weight": 1 },
    { "id": "hope-09", "text": "现在的沉默，不代表努力没有回声。", "mood": "hope", "weight": 1 },
    { "id": "hope-10", "text": "只要还愿意往前，今天就不算白费。", "mood": "hope", "weight": 1 },
    { "id": "hope-11", "text": "你正在成为，那个能接住自己的大人。", "mood": "hope", "weight": 1 },
    { "id": "hope-12", "text": "先把眼前这一步走好，路会继续展开。", "mood": "hope", "weight": 1 },
    { "id": "missing-01", "text": "迷茫的时候，先别急着给自己定论。", "mood": "missing", "weight": 1 },
    { "id": "missing-02", "text": "你不是没有方向，只是还在雾里。", "mood": "missing", "weight": 1 },
    { "id": "missing-03", "text": "看不清未来时，先照顾好今天。", "mood": "missing", "weight": 1 },
    { "id": "missing-04", "text": "低谷里走得慢，也是在往上爬。", "mood": "missing", "weight": 1 },
    { "id": "missing-05", "text": "有些答案，需要等你走远一点。", "mood": "missing", "weight": 1 },
    { "id": "missing-06", "text": "你暂时停下，不代表你已经输了。", "mood": "missing", "weight": 1 },
    { "id": "missing-07", "text": "别把一段低落，误认为全部人生。", "mood": "missing", "weight": 1 },
    { "id": "missing-08", "text": "你可以承认很难，再决定下一步。", "mood": "missing", "weight": 1 },
    { "id": "missing-09", "text": "今天只做一件事，也足够重要。", "mood": "missing", "weight": 1 },
    { "id": "missing-10", "text": "不是你不够好，是这段路真的很难。", "mood": "missing", "weight": 1 },
    { "id": "missing-11", "text": "你还没有走完，所以故事还没定稿。", "mood": "missing", "weight": 1 },
    { "id": "missing-12", "text": "失去方向的日子，也会慢慢过去。", "mood": "missing", "weight": 1 },
    { "id": "courage-01", "text": "别再替所有人的期待，惩罚自己。", "mood": "courage", "weight": 1 },
    { "id": "courage-02", "text": "你的感受不麻烦，也不需要道歉。", "mood": "courage", "weight": 1 },
    { "id": "courage-03", "text": "不想答应的事，可以认真说不。", "mood": "courage", "weight": 1 },
    { "id": "courage-04", "text": "你不必缩小自己，换取别人的认可。", "mood": "courage", "weight": 1 },
    { "id": "courage-05", "text": "害怕也可以出发，勇气本来就会发抖。", "mood": "courage", "weight": 1 },
    { "id": "courage-06", "text": "你有权重新选择，不必困在旧答案里。", "mood": "courage", "weight": 1 },
    { "id": "courage-07", "text": "你不必急着好起来，先让自己喘口气。", "mood": "courage", "weight": 1 },
    { "id": "courage-08", "text": "你不是太敏感，你只是感受得很真。", "mood": "courage", "weight": 1 },
    { "id": "courage-09", "text": "不完美的你，也值得被自己尊重。", "mood": "courage", "weight": 1 },
    { "id": "courage-10", "text": "先站回自己这边，再决定要去哪里。", "mood": "courage", "weight": 1 },
    { "id": "courage-11", "text": "你可以离开消耗你的地方。", "mood": "courage", "weight": 1 },
    { "id": "courage-12", "text": "不必解释每一次沉默，先让自己自在。", "mood": "courage", "weight": 1 },
    { "id": "dream-01", "text": "月光不会催你，今晚可以慢一点。", "mood": "dream", "weight": 1 },
    { "id": "dream-02", "text": "风吹散的不是你，是今天的疲惫。", "mood": "dream", "weight": 1 },
    { "id": "dream-03", "text": "星星落下来，替你收好未完成的事。", "mood": "dream", "weight": 1 },
    { "id": "dream-04", "text": "夜色很深，但你不用想通一切。", "mood": "dream", "weight": 1 },
    { "id": "dream-05", "text": "给明天留一点空白，答案会慢慢出现。", "mood": "dream", "weight": 1 },
    { "id": "dream-06", "text": "愿你醒来时，心里少一点责备。", "mood": "dream", "weight": 1 },
    { "id": "dream-07", "text": "今晚先睡吧，很多事天亮再看。", "mood": "dream", "weight": 1 },
    { "id": "dream-08", "text": "你值得一个，不用一直赶路的夜晚。", "mood": "dream", "weight": 1 },
    { "id": "dream-09", "text": "把委屈放在月光下，先让它透口气。", "mood": "dream", "weight": 1 },
    { "id": "dream-10", "text": "星光不是答案，却提醒你别熄灭。", "mood": "dream", "weight": 1 },
    { "id": "dream-11", "text": "如果今天太重，就把明天拆成一小步。", "mood": "dream", "weight": 1 },
    { "id": "dream-12", "text": "愿你把自己，从匆忙里轻轻领回来。", "mood": "dream", "weight": 1 }
  ],
  "fallback": { "id": "system-fallback", "text": "今晚不必证明自己", "mood": "calm", "weight": 1 }
}
