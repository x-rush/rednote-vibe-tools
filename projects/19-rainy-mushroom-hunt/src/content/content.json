  "fieldNotes": [
    {
      "id": "muscaria",
      "name": "毒蝇伞",
      "latin": "Amanita muscaria",
      "status": "有毒 · 仅作科普观察",
      "appearance": "典型形象是红色菌盖上散布白色斑点；这段描述不是完整鉴定特征。",
      "ecology": "它能与树根建立菌根共生关系：帮助树木获取水分和养分，同时从树木获得糖。",
      "fact": "有毒菌同样参与森林生态。漂亮、常见于童话，并不代表可以食用。",
      "sources": [
        {
          "title": "英国皇家植物园 Kew · Fungal favourites",
          "url": "https://www.kew.org/read-and-watch/kew-scientists-pick-their-favourite-fungus"
        },
        {
          "title": "Kew Grow Wild · Deck the halls with festive fungi",
          "url": "https://growwild.kew.org/blog/deck-halls-festive-fungi"
        }
      ]
    },
    {
      "id": "verna",
      "name": "春生鹅膏",
      "latin": "Amanita verna",
      "status": "剧毒 · 仅作科普观察",
      "appearance": "Kew 介绍其外观为纯白色。朴素的颜色不能作为无毒依据。",
      "ecology": "与树根形成外生菌根共生，Kew 记录其通常见于欧洲春季林地。",
      "fact": "含有可造成严重肝损伤的鹅膏毒肽。游戏不提供采食或处理方法。",
      "sources": [
        {
          "title": "英国皇家植物园 Kew · Fungal favourites",
          "url": "https://www.kew.org/read-and-watch/kew-scientists-pick-their-favourite-fungus"
        }
      ]
    },
    {
      "id": "phalloides",
      "name": "毒鹅膏",
      "latin": "Amanita phalloides",
      "status": "剧毒 · 仅作科普观察",
      "appearance": "有毒菌与人们熟悉的其他菌类可能相似；不能用游戏插图或简短文字确认身份。",
      "ecology": "CDC 曾记录美国加州因采食该菌引起的多人中毒事件。",
      "fact": "其毒素可导致严重肝损伤，甚至死亡。观察记录的价值不需要通过采食证明。",
      "sources": [
        {
          "title": "CDC · Amanita phalloides Mushroom Poisonings, 2016",
          "url": "https://www.cdc.gov/mmwr/volumes/66/wr/mm6621a1.htm"
        }
      ]
    },
    {
      "id": "xylaria",
      "name": "多形炭角菌",
      "latin": "Xylaria polymorpha",
      "status": "生态观察 · 不作食用判断",
      "appearance": "子实体呈伸出的手指状，成熟时颜色变黑；菌类不一定都有伞状菌盖。",
      "ecology": "以死亡或腐朽的植物为营养来源，分解有机物，参与森林中的养分循环。",
      "fact": "寻找菌类时，可以留意倒木与腐朽植物附近，观察它们与生境的关系。",
      "sources": [
        {
          "title": "英国皇家植物园 Kew · Fungal favourites",
          "url": "https://www.kew.org/read-and-watch/kew-scientists-pick-their-favourite-fungus"
        }
      ]
    }
  ],
