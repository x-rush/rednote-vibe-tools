      { "boundaryId": "rule-safety", "label": "危险情境优先保证安全", "textKey": "boundary-safety", "severity": 3, "scenarioTags": ["safety"] }
    ],
    "sentenceFragments": [
      { "textKey": "pref-contact-brief", "sourceSectionId": "section-contact", "cardSectionId": "companion", "kind": "preference", "text": "忙碌时，一句简短的“我看到了，晚些回复”会让我更安心。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-contact-flexible", "sourceSectionId": "section-contact", "cardSectionId": "companion", "kind": "preference", "text": "我不需要固定频率的联系，但重要变化希望能及时知道。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-reply-expectation", "sourceSectionId": "section-contact", "cardSectionId": "companion", "kind": "preference", "text": "如果暂时无法回复，能让我大概知道什么时候再联系会更舒服。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-plan-change", "sourceSectionId": "section-contact", "cardSectionId": "companion", "kind": "preference", "text": "已经约好的计划要改变时，我希望我们尽早说，并一起确定下一步。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-listen-first", "sourceSectionId": "section-listening", "cardSectionId": "sadness", "kind": "preference", "text": "我诉说烦恼时，通常希望先被听完，再考虑解决办法。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-ask-mode", "sourceSectionId": "section-listening", "cardSectionId": "sadness", "kind": "preference", "text": "你可以先问我：“现在更需要我听，还是一起想办法？”", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-confirm-feeling", "sourceSectionId": "section-listening", "cardSectionId": "sadness", "kind": "preference", "text": "当我表达难受时，一句具体的确认比立刻说服我更有帮助。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-separate-fact", "sourceSectionId": "section-listening", "cardSectionId": "disagreement", "kind": "preference", "text": "出现分歧时，我希望我们把事实、各自的解释和感受分开来说。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-conflict-timing", "sourceSectionId": "section-conflict", "cardSectionId": "disagreement", "kind": "preference", "text": "我更适合在情绪稍微平稳后，约一个明确时间继续谈。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-space", "sourceSectionId": "section-space", "cardSectionId": "companion", "kind": "preference", "text": "我需要独处时，希望这段空间可以被尊重，而不是被理解成惩罚或拒绝。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-care-action", "sourceSectionId": "section-care", "cardSectionId": "care", "kind": "preference", "text": "对我来说，具体行动常常比泛泛的安慰更容易被感受到。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-care-words", "sourceSectionId": "section-care", "cardSectionId": "care", "kind": "preference", "text": "我也需要听见直接、清楚的关心，而不是总靠猜。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-care-details", "sourceSectionId": "section-care", "cardSectionId": "care", "kind": "preference", "text": "你记得那些对我重要的小事时，我会感到自己被放在心上。", "sensitive": false, "compactDefault": true },
      { "textKey": "pref-help-choice", "sourceSectionId": "section-care", "cardSectionId": "care", "kind": "preference", "text": "想帮助我时，给我几个可选择的方式，会让我既被支持又保有自主。", "sensitive": false, "compactDefault": true },
      { "textKey": "boundary-no-disappear", "sourceSectionId": "section-conflict", "cardSectionId": "avoid", "kind": "boundary", "text": "冲突可以暂停，但我不能接受用突然失联来惩罚或迫使我让步。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-no-label", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "我愿意谈具体行为，但不接受用“你就是……”给整个人下结论。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-no-threat", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "我不能接受用分手、离开或伤害自己来逼迫我立刻答应。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-private", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "涉及我的私事时，请在分享给别人之前先问我。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-identifiable", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "即使不说名字，只要别人可能认出我，也希望你先征得同意。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-no-pressure", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "当我说“不”时，可以询问一次原因，但请不要反复施压。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-public-conflict", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "我不希望私下的冲突未经同意被带到公开场合讨论。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-jokes", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "如果我明确说某个玩笑让我不舒服，希望它可以停止，而不是要求我证明自己为什么介意。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-device", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "未经同意查看我的设备、账号或私人记录，会越过我的边界。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-time", "sourceSectionId": "section-contact", "cardSectionId": "avoid", "kind": "boundary", "text": "紧急以外的事情，我不保证随时能够回应；延迟回复不等于不在乎。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-space", "sourceSectionId": "section-space", "cardSectionId": "avoid", "kind": "boundary", "text": "我提出需要空间时，不代表对方可以无限期消失；我们仍需要基本约定。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-advice", "sourceSectionId": "section-listening", "cardSectionId": "avoid", "kind": "boundary", "text": "如果我明确只想被听见，请不要持续给建议或评价我的选择。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-promise", "sourceSectionId": "section-conflict", "cardSectionId": "avoid", "kind": "boundary", "text": "我不希望在情绪最激烈的时候被要求作出长期承诺。", "sensitive": true, "compactDefault": false },
      { "textKey": "boundary-safety", "sourceSectionId": "section-boundary", "cardSectionId": "avoid", "kind": "boundary", "text": "如果出现威胁、控制或伤害，安全会优先于把一场对话“说完整”。", "sensitive": true, "compactDefault": false },
      { "textKey": "commit-say-change", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "如果我的需要发生变化，我愿意重新说出来，而不是要求你一直猜中。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-clarify", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "我会尽量说具体发生了什么，而不是只用评价描述你。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-listen", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "当你表达不同需要时，我也愿意先确认自己是否听懂。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-pause", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "如果我要暂停争论，我会尽量说明原因和大概何时回来。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-return", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "暂停之后，我愿意主动回来完成尚未说完的重要部分。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-no-mindread", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "我会提醒自己：对方没有立刻做到，不一定等于故意忽视。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-own-impact", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "即使我的出发点没有恶意，我也愿意听见行为造成的实际影响。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-no-overpromise", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "我不会为了尽快结束冲突而答应自己无法持续做到的事。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-boundary", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "我会尽量在边界被反复越过之前说明，而不是积累到突然爆发。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-respect-no", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "我也愿意尊重对方的拒绝，不把亲密当作必须答应的理由。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-private", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "我会同样保护对方的隐私，不把分享当作解决冲突的手段。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-repair-action", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "道歉之后，我愿意和你一起确认下一次可以怎样做得不同。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-check-assumption", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "当我发现自己在猜测你的动机时，我会尽量把猜测当作问题来确认。", "sensitive": false, "compactDefault": true },
      { "textKey": "commit-not-contract", "sourceSectionId": "section-repair", "cardSectionId": "commitment", "kind": "commitment", "text": "这份说明书是一次沟通的起点；我愿意让它在真实相处中被修改。", "sensitive": false, "compactDefault": true }
    ],
