    "sets": [
      { "id": "first-fire", "name": "泥火初声", "description": "从泥、骨与玉的造型中辨认早期制造留下的证据。", "sealLabel": "泥火", "guideCompleteLines": ["四件早期器物已经归位，泥、骨与玉留下了第一组线索。", "这一柜从火与手开始，下一次去看礼器怎样组织秩序。", "泥火初声封签完成，记得它们首先都是被制造出来的物。"] },
      { "id": "ritual-bronze", "name": "礼乐铸境", "description": "沿青铜器的结构、用途与组合关系理解礼制空间。", "sealLabel": "铸境", "guideCompleteLines": ["四件青铜重器已经归位，形制和用途终于连成了一条线。", "礼乐铸境封签完成，复杂不等于神秘，结构就是证据。", "这一柜收好了；下一柜会让青铜从器用转向声音与交流。"] },
      { "id": "chu-sound", "name": "楚风新声", "description": "从声音、宴飨、兵器与动物形器物观察区域交流。", "sealLabel": "楚声", "guideCompleteLines": ["楚风新声四格归位，声音、铸造与交流被放进了同一柜。", "这一组不只宏大，它留下的文字、声音和结构都可以互证。", "楚声封签完成；别急着走，下一柜的光会落到汉代生活里。"] },
      { "id": "han-light", "name": "汉室长明", "description": "借灯具、葬具、香具与陶俑观察汉代生活的不同侧面。", "sealLabel": "长明", "guideCompleteLines": ["汉室长明四格归位，光、香、身体与表演各自留下证据。", "这组最容易被华丽外观带偏，你已经学会先问用途和结构。", "长明封签完成；接下来看看盛唐器物怎样容纳更远的世界。"] },
      { "id": "tang-world", "name": "盛唐万象", "description": "从金银器、香具与乐舞俑观察盛唐的工艺和往来。", "sealLabel": "万象", "guideCompleteLines": ["盛唐万象四格归位，材料、机械与乐舞终于彼此照见。", "五组档案的最后一柜已经封签，但物华录仍可以继续细读。", "万象入册完成；回到时间轴，你会看到二十件旧物怎样相连。"] }
    ],
