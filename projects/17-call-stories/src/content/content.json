  "callScripts": [
    {
      "id": "basketball",
      "title": "朋友约打球",
      "optionLabel": "朋友约打球 · 男声",
      "voice": "轻松带笑的青年男声",
      "prompt": "像给很熟的朋友打电话约打球，随口说，轻松直接。按短语自然连读，寒暄和语气词轻轻带过，六点稍微说清楚，句尾干脆，不拖腔，不逐字重读，不要播音腔或夸张表演。",
      "autoEnd": true,
      "segments": [
        {
          "file": "basketball-01.mp3",
          "text": "喂，干嘛呢？下午打球去啊。",
          "pause": 5
        },
        {
          "file": "basketball-02.mp3",
          "text": "六点老地方，我带球你带水。",
          "pause": 4
        },
        {
          "file": "basketball-03.mp3",
          "text": "那待会儿见啊。",
          "pause": 2
        }
      ],
      "voiceName": "温暖阿虎 2.0"
    },
    {
      "id": "dinner",
      "title": "朋友约饭",
      "optionLabel": "朋友约饭 · 女声",
      "voice": "自然爽朗的青年女声",
      "prompt": "成年女性给很熟的朋友打电话约饭。饿了，顺口直接叫朋友出来，轻松爽快，正常音量，稍有兴致。短语连读，语气词轻带，不请求不客套，不幼态，不逐字念稿，不夸张兴奋。",
      "autoEnd": true,
      "segments": [
        {
          "file": "dinner-01.mp3",
          "text": "喂，出来吃饭走，我都饿了。",
          "pause": 5
        },
        {
          "file": "dinner-02.mp3",
          "text": "就上次那家，六点啊。我今天得多点两个菜。",
          "pause": 5
        },
        {
          "file": "dinner-03.mp3",
          "text": "我换个衣服就出门。待会儿见啊。",
          "pause": 2
        }
      ],
      "voiceName": "小何 2.0"
    },
    {
      "id": "work",
      "title": "公司临时有事",
      "optionLabel": "临时加班 · 女声",
      "voice": "清晰平稳的成熟女声",
      "prompt": "成年女同事给熟悉的同事打电话，临时协调晚上到公司确认材料。平实清楚、语气自然有分寸，像日常交代事情。时间和任务说清楚，其他短语顺畅连读，给对方安排的余地。不是客服播报，不逐字重读，不撒娇，不朗诵。",
      "autoEnd": true,
      "segments": [
        {
          "file": "work-01.mp3",
          "text": "喂，现在方便说两句吗？公司这边临时有点事情，想问问你晚上能不能过来一下。",
          "pause": 6
        },
        {
          "file": "work-02.mp3",
          "text": "主要是把明天要用的材料再确认一下，预计一个小时左右。你先看看自己的安排。",
          "pause": 5
        },
        {
          "file": "work-03.mp3",
          "text": "要是不方便，晚点告诉我就行，我再协调。那先这样。",
          "pause": 2
        }
      ],
      "voiceName": "Vivi 2.0"
    },
    {
      "id": "miss-you",
      "title": "只是想你了",
      "optionLabel": "想你了 · 女声",
      "voice": "略带娇羞、轻轻撒娇的成年女声",
      "prompt": "成年女性给熟悉的恋人打电话，主动说想他，有一点娇羞，又想让对方多陪自己一会儿。正常聊天音量稍轻，声音亲近柔和，短语连读。开头轻轻说喂，有点想你了带一点不好意思，就给你打个电话自然轻快地接过去，像在掩饰害羞。第二句前半随口说，只有电话先别挂嘛带一点软软的撒娇和舍不得，末尾嘛轻轻收住。保持成年女性日常说话的声音，不夹嗓子，不幼态，不逐字拖长，不刻意喘息、笑出声或用朗诵腔。",
      "autoEnd": false,
      "segments": [
        {
          "file": "miss-you-01.mp3",
          "text": "喂，有点想你了，就给你打个电话。",
          "pause": 4
        },
        {
          "file": "miss-you-02.mp3",
          "text": "也没什么事，你忙你的。电话先别挂嘛。",
          "pause": 0
        }
      ],
      "voiceName": "魅力女友 2.0"
    },
    {
      "id": "downstairs",
      "title": "楼下等你",
      "optionLabel": "楼下等你 · 男声",
      "voice": "温和踏实的青年男声",
      "prompt": "给熟悉的人打电话，说自己快到楼下了。正常说话音量，松弛亲近，短语连读，关心是顺口提醒，不是朗诵。不要刻意拖慢，不逐字重读，句尾自然。",
      "autoEnd": true,
      "segments": [
        {
          "file": "downstairs-01.mp3",
          "text": "喂，我快到了。你慢慢收拾，不用着急。",
          "pause": 5
        },
        {
          "file": "downstairs-02.mp3",
          "text": "我就在楼下等你，出门之前看看东西有没有带齐。",
          "pause": 5
        },
        {
          "file": "downstairs-03.mp3",
          "text": "外面有点风，记得带件外套。那我先挂了，待会儿见。",
          "pause": 2
        }
      ],
      "voiceName": "温暖阿虎 2.0"
    },
    {
      "id": "company",
      "title": "陪你待会儿",
      "optionLabel": "陪你待会儿 · 男声",
      "voice": "低声放松的青年男声",
      "prompt": "成年男性给熟悉亲近的人随手打电话，像平常聊天，轻松自然。正常音量，短语连读。也没什么事轻快带过；电话先这么放着吧是随口提议；我陪你待会儿平常地收尾。不用安抚口吻，不刻意压低声音，不深情朗诵，不逐字重读，不拖长语气词，不添加笑声。",
      "autoEnd": false,
      "segments": [
        {
          "file": "company-01.mp3",
          "text": "喂，也没什么事，就想给你打个电话。",
          "pause": 3
        },
        {
          "file": "company-02.mp3",
          "text": "电话先这么放着吧，我陪你待会儿。",
          "pause": 0
        }
      ],
      "voiceName": "温暖阿虎 2.0"
    }
  ],
